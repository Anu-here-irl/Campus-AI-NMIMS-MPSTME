<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FEF3C7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROPOSED CHANGE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#B45309"
                android:background="#FDE68A"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_proposal_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Computer Networks"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#92400E" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_proposal_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Computer Networks examination rescheduled"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#78350F"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tv_proposal_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Moved to Room 204 on 14 November at 10 AM"
            android:textSize="13sp"
            android:textColor="#92400E"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_proposal_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New Location: Room 204"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#B45309"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btn_reject_proposal"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reject"
                android:textColor="#DC2626" />

            <Button
                android:id="@+id/btn_confirm_proposal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm Change"
                android:backgroundTint="#D97706"
                android:textColor="@color/white"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
