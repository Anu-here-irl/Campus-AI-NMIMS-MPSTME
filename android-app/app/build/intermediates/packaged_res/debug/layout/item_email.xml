<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Row: Category Badge, Importance, Date, Star -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/view_unread_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_timeline_dot"
                android:backgroundTint="@color/accent"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_email_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIMETABLE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/tag_timetable"
                android:background="@drawable/bg_category_badge"
                android:backgroundTint="@color/tag_timetable_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <TextView
                android:id="@+id/tv_email_importance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/priority_high"
                android:background="@drawable/bg_category_badge"
                android:backgroundTint="@color/priority_high_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/view_uncertain_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠ Review"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#B45309"
                android:background="@drawable/bg_category_badge"
                android:backgroundTint="#FEF3C7"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="6dp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_email_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20 Oct"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:id="@+id/iv_email_star"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_star_outline"
                app:tint="@color/text_secondary"
                android:contentDescription="Bookmark Email" />
        </LinearLayout>

        <!-- Sender Name -->
        <TextView
            android:id="@+id/tv_email_sender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Academic Cell &lt;academic@campus.edu&gt;"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <!-- Subject -->
        <TextView
            android:id="@+id/tv_email_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Updated Computer Networks Mid-Term Schedule"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
