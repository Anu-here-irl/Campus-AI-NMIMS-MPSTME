<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <!-- Category / Code Pill -->
    <TextView
        android:id="@+id/tv_search_code"
        android:layout_width="wrap_content"
        android:minWidth="64dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="E-CR-G1"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:background="@drawable/item_border_unselected"
        android:paddingHorizontal="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tv_search_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Classroom G1 (E CR G1)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_search_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ground Floor • Classroom"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_search_verified_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓ Verified"
        android:textSize="10sp"
        android:textColor="#059669"
        android:textStyle="bold"
        android:layout_marginStart="8dp" />

</LinearLayout>
