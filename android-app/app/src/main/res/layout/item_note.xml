<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_note_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NLP"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_category_badge"
                android:backgroundTint="@color/primary_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <TextView
                android:id="@+id/tv_note_chunks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ 4 chunks indexed"
                android:textSize="11sp"
                android:textColor="@color/status_confirmed"
                android:background="@drawable/bg_category_badge"
                android:backgroundTint="@color/status_confirmed_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginStart="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_note_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-10-20"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tokenization and POS Tagging"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_note_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Word tokenization breaks text into individual token units. Sentence tokenization handles boundary detection."
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
