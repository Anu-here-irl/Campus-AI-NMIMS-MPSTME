<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_email_detail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="Email Notice"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Subject & Sender Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="@color/card_bg"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_detail_subject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Computer Networks examination notice"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_detail_sender_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="From: exam-cell@campus.edu (ADMIN) • 2026-10-26"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="6dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginVertical="12dp" />

                    <!-- Classification Pills -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_detail_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EXAM (82.4%)"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/tag_exam"
                            android:background="@drawable/bg_category_badge"
                            android:backgroundTint="@color/tag_exam_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp" />

                        <TextView
                            android:id="@+id/tv_detail_importance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HIGH PRIORITY (79.1%)"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/priority_high"
                            android:background="@drawable/bg_category_badge"
                            android:backgroundTint="@color/priority_high_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_detail_warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠ Review Recommended: Model prediction confidence fell below threshold."
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#B45309"
                        android:background="@drawable/bg_category_badge"
                        android:backgroundTint="#FEF3C7"
                        android:padding="8dp"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Timetable Change Proposal Card (Conditional) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_proposal_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FEF3C7"
                app:strokeWidth="1dp"
                app:strokeColor="#FDE68A"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EXTRACTED EVENT PROPOSAL"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#B45309" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_detail_proposal_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The examination has been moved to Room 204 on 14 November at 10 AM."
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#78350F"
                        android:layout_marginTop="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_detail_reject"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reject"
                            android:textColor="@color/priority_high" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_detail_confirm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Confirm Update"
                            android:backgroundTint="#D97706"
                            android:textColor="@color/white"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Extracted Entities (Dates, Rooms, Subjects) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_entities_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="@color/card_bg"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EXTRACTED ENTITIES &amp; INFORMATION"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tv_detail_entities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dates: 14 November 2026\nVenue: Room 204\nSubject: Computer Networks"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Email Body Content -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MESSAGE BODY"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_detail_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The Computer Networks examination scheduled for 12 November has been moved to Room 204 on 14 November at 10 AM. Submit your hall tickets before the deadline."
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="5dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
